{
  "name": "akuntansi-zee-simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:routes": "node scripts/check-routes.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "coa:check": "node --conditions=react-server --import tsx prisma/seed.ts --check",
    "coa:audit": "node --import tsx scripts/verify-coa-approved.ts",
    "test:coa:neon": "node --conditions=react-server --import tsx --test tests/integration/coa-neon.test.ts",
    "test:journal:neon": "node --conditions=react-server --import tsx --test tests/integration/journal-neon.test.ts",
    "test:loans:neon": "node --conditions=react-server --import tsx --test tests/integration/loans-neon.test.ts",
    "test:trade:neon": "node --conditions=react-server --import tsx --test tests/integration/trade-neon.test.ts",
    "test:reports:neon": "node --conditions=react-server --import tsx --test tests/integration/reports-neon.test.ts",
    "test:opening:neon": "node --conditions=react-server --import tsx --test tests/integration/opening-neon.test.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "fontkit": "2.0.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pdfkit": "0.20.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
